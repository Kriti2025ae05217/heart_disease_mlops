{
  "title": "Heart API",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Request rate (req/s) by path",
     "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (path) (rate(http_requests_total[1m]))"}]},
    {"id": 2, "type": "timeseries", "title": "p95 latency (s)",
     "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{path=\"/predict\"}[5m])))"}]},
    {"id": 3, "type": "timeseries", "title": "Predictions by class",
     "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (class) (increase(predictions_total[5m]))"}]},
    {"id": 4, "type": "stat", "title": "4xx/5xx responses (5m)",
     "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(increase(http_requests_total{status=~\"4..|5..\"}[5m]))"}]}
  ]
}
